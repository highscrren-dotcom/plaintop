{
  "_": "Vocabulary of block types. The settings dialogs are built from it, not from a list in the code: a new block type must not need an interface change. The texts are English source strings; po/extract.py puts them into the catalogs.",
  "header": {
    "name": "Header",
    "hint": "The top line: your text and the hostname joined by “\\”; with no text, only the hostname",
    "params": {
      "text": {
        "type": "string",
        "name": "Text",
        "default": ""
      },
      "hostname": {
        "type": "bool",
        "name": "Append the hostname",
        "default": true
      }
    }
  },
  "clock": {
    "name": "Clock",
    "params": {
      "seconds": {
        "type": "bool",
        "name": "Seconds in a small size",
        "default": true
      }
    }
  },
  "date": {
    "name": "Date",
    "params": {}
  },
  "os": {
    "name": "System and kernel",
    "params": {}
  },
  "separator": {
    "name": "Separator",
    "params": {}
  },
  "cpu": {
    "name": "Processor",
    "params": {
      "per_socket": {
        "type": "bool",
        "name": "Lines per NUMA node",
        "default": true
      },
      "model_line": {
        "type": "bool",
        "name": "Model, temperatures, fans",
        "default": true
      },
      "top_processes": {
        "type": "int",
        "name": "Processes in the top list",
        "default": 5,
        "min": 0,
        "max": 15
      },
      "fans": {
        "type": "stringlist",
        "name": "Fan sensors (empty — find them)",
        "default": [],
        "pick": "sensor",
        "pattern": "^lmsensors/[^/]+/fan\\d+$"
      }
    }
  },
  "memory": {
    "name": "Memory",
    "params": {
      "totals": {
        "type": "bool",
        "name": "The “used / total” line",
        "default": true
      },
      "top_processes": {
        "type": "int",
        "name": "Processes in the top list",
        "default": 5,
        "min": 0,
        "max": 15
      }
    }
  },
  "gpu": {
    "name": "Graphics card",
    "params": {
      "details": {
        "type": "bool",
        "name": "VRAM, temperature and power line",
        "default": true
      }
    }
  },
  "disks": {
    "name": "Disks",
    "params": {
      "mounts": {
        "type": "stringlist",
        "name": "Mount points",
        "default": [
          "/"
        ],
        "pick": "mount"
      },
      "nvme_temp": {
        "type": "bool",
        "name": "NVMe temperature on the root line",
        "default": true
      },
      "nvmeSensor": {
        "type": "string",
        "name": "NVMe temperature sensor (empty — find it)",
        "default": "",
        "pick": "sensor",
        "pattern": "^lmsensors/nvme-[^/]+/temp\\d+$"
      }
    }
  },
  "uptime": {
    "name": "Uptime",
    "params": {}
  },
  "network": {
    "name": "Network",
    "params": {
      "interface": {
        "type": "string",
        "name": "Interface (empty — find it)",
        "default": "",
        "pick": "iface"
      }
    }
  },
  "services": {
    "name": "Services",
    "hint": "docker, ollama, pending updates — a script inside the package",
    "params": {}
  },
  "passport": {
    "name": "Hardware spec sheet",
    "hint": "Static lines: processor, graphics card, board",
    "params": {}
  },
  "command": {
    "name": "Custom command",
    "hint": "A line from the output of any command",
    "params": {
      "label": {
        "type": "string",
        "name": "Label",
        "default": "cmd"
      },
      "command": {
        "type": "string",
        "name": "Command",
        "default": "echo ok"
      },
      "interval": {
        "type": "int",
        "name": "Interval, s",
        "default": 30,
        "min": 1,
        "max": 3600
      },
      "lines": {
        "type": "int",
        "name": "Lines to show",
        "default": 1,
        "min": 1,
        "max": 20
      }
    }
  },
  "sensor": {
    "name": "Custom sensor",
    "hint": "Any ksystemstats sensor by its id",
    "params": {
      "label": {
        "type": "string",
        "name": "Label",
        "default": "SEN"
      },
      "id": {
        "type": "string",
        "name": "Sensor id",
        "default": "cpu/all/usage",
        "pick": "sensor",
        "pattern": ""
      },
      "bar": {
        "type": "bool",
        "name": "Draw a bar",
        "default": true
      },
      "suffix": {
        "type": "string",
        "name": "Suffix after the value",
        "default": ""
      },
      "digits": {
        "type": "int",
        "name": "Decimal places",
        "default": 0,
        "min": 0,
        "max": 3
      }
    }
  }
}
