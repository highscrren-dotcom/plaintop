<?xml version="1.0" encoding="UTF-8"?>
<kcfg xmlns="http://www.kde.org/standards/kcfg/1.0"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="http://www.kde.org/standards/kcfg/1.0
      http://www.kde.org/standards/kcfg/1.0/kcfg.xsd" >
  <kcfgfile name=""/>

  <group name="General">
    <!-- Click-through: the applet's wrapper in the shell is disabled, so both mouse
         buttons reach the desktop as if the widget were not there; only the shell's edit
         mode gives the widget the mouse back. Off by default: a first install that cannot
         be clicked would hide its own settings. XML comments forbid a double hyphen, so
         the installer's "clicks off" switch is spelled out rather than quoted. -->
    <entry name="clickThrough" type="Bool">
      <default>false</default>
    </entry>
    <!-- Active lines: a line with something to do runs it on a left click and lists its
         actions on a right click; while clicks go through, those lines alone take the
         mouse (a containment mask that asks the view). Off, no line takes a click. -->
    <entry name="actions" type="Bool">
      <default>true</default>
    </entry>
    <!-- The terminal the actions open: a command the rest is appended to, as
         "konsole -e sh -c '…'". Empty means konsole. -->
    <entry name="terminal" type="String">
      <default>konsole -e</default>
    </entry>
    <!-- The editor a repository is opened in; its path is the argument. -->
    <entry name="editor" type="String">
      <default>kate</default>
    </entry>
    <!-- The menu's frame: eight characters — top-left, horizontal, top-right, vertical,
         bottom-left, bottom-right, two junctions — the same setting as the calendar's. -->
    <entry name="frame" type="String">
      <default>┌─┐│└┘├┤</default>
    </entry>
    <!-- The menu's sheet behind the text, and how opaque it is. -->
    <entry name="colorPaper" type="String">
      <default>#141820</default>
    </entry>
    <entry name="paperOpacity" type="Int">
      <default>94</default>
    </entry>
    <!-- Palette, carried over from conky/plainext.conf. The line builder works in roles
         ("fg", "dim", "accent", "value") and the view maps them to these four. -->
    <entry name="colorFg" type="String">
      <default>#C8CCD4</default>
    </entry>
    <entry name="colorAccent" type="String">
      <default>#E05561</default>
    </entry>
    <entry name="colorDim" type="String">
      <default>#6B7280</default>
    </entry>
    <entry name="colorValue" type="String">
      <default>#8FB6E0</default>
    </entry>
    <entry name="fontFamily" type="String">
      <default>JetBrainsMono Nerd Font Mono</default>
    </entry>
    <entry name="fontSize" type="Int">
      <default>10</default>
    </entry>
    <entry name="padLeft" type="Int">
      <default>48</default>
    </entry>
    <entry name="padTop" type="Int">
      <default>44</default>
    </entry>
    <entry name="widgetWidth" type="Int">
      <default>500</default>
    </entry>
    <entry name="widgetHeight" type="Int">
      <default>950</default>
    </entry>
    <!-- Bars: their width in characters and the two characters they are made of — the
         slash of PlainExt and a space. An empty character means that default (a lone
         space would not survive the config). A label wider than three characters takes
         its extra from the bar, so the percent column keeps its place. -->
    <entry name="barWidth" type="Int">
      <default>18</default>
    </entry>
    <entry name="barFill" type="String">
      <default>/</default>
    </entry>
    <entry name="barEmpty" type="String">
      <default></default>
    </entry>
    <!-- The separator line: its character and width. -->
    <entry name="separatorChar" type="String">
      <default>-</default>
    </entry>
    <entry name="separatorWidth" type="Int">
      <default>35</default>
    </entry>
    <!-- Sparklines, drawn by the "history" parameter of the bar blocks: the glyphs from
         lowest to highest. Block elements by default; any run of characters works. -->
    <entry name="sparkGlyphs" type="String">
      <default>▁▂▃▄▅▆▇█</default>
    </entry>
    <!-- The second column's left edge in pixels from the widget's left edge; 0 puts it
         at half the width. A block goes there by its "column" field on the Blocks page. -->
    <entry name="secondColumn" type="Int">
      <default>0</default>
    </entry>
    <entry name="updateInterval" type="Int">
      <default>1000</default>
    </entry>
    <!-- Seconds between reads of the process list: the most expensive thing collected. -->
    <entry name="processInterval" type="Int">
      <default>2</default>
    </entry>
    <!-- Block layout as a single JSON string. When empty, the layout generated from
         schema/widget.json and shipped in the package is used (contents/code/description.js). -->
    <entry name="blocksJson" type="String">
      <default></default>
    </entry>
  </group>

</kcfg>
