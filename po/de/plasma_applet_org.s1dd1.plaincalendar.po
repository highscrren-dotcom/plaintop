#: calendar/package/contents/ui/configAccounts.qml:338
#, kde-format
msgid ""
"A “Desktop app” OAuth client from console.cloud.google.com, with the "
"Calendar API\n"
"enabled. Save, then sign in once from a terminal:\n"
"python3 %1 google-auth %2"
msgstr ""
"Ein OAuth-Client „Desktop app“ von console.cloud.google.com mit aktivierter "
"Calendar API.\n"
"Speichern, dann einmal im Terminal anmelden:\n"
"python3 %1 google-auth %2"

