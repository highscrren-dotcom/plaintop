msgid ""
"Eight characters: the corners, the horizontal, the vertical and the two\n"
"junctions of a separator — “┌─┐│└┘├┤”, or “+-+|+++” in plain ASCII."
msgstr ""
"Oito caracteres: os cantos, a horizontal, a vertical e as duas\n"
"junções de um separador — “┌─┐│└┘├┤”, ou “+-+|+++” em ASCII simples."

