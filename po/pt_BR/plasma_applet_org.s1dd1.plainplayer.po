msgid "whoever is playing"
msgstr "quem estiver tocando"

#: player/package/contents/ui/configGeneral.qml:86
msgid ""
"Empty: whoever is playing. Otherwise a part of the player's name\n"
"or desktop entry — vlc, spotify, strawberry; when no player matches,\n"
"back to whoever is playing."
msgstr ""
"Vazio: quem estiver tocando. Senão, parte do nome do reprodutor\n"
"ou da entrada desktop — vlc, spotify, strawberry; quando nenhum "
"corresponde,\n"
"volta para quem estiver tocando."

