msgctxt "player field placeholder"
msgid "whoever is playing"
msgstr "celui qui joue"

#: spectrum/package/contents/ui/configPlayer.qml:109
msgid ""
"Empty: whoever is playing. Otherwise a part of the player's name\n"
"or desktop entry — vlc, spotify, strawberry; when no player matches,\n"
"back to whoever is playing."
msgstr ""
"Vide : celui qui joue. Sinon une partie du nom du lecteur\n"
"ou de son entrée desktop — vlc, spotify, strawberry ; si aucun lecteur\n"
"ne correspond, retour à celui qui joue."

