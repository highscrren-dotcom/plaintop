#: win/host/settings/CalendarHolidays.qml:92
msgid "the UN's and UNESCO's best known international days"
msgstr "самые известные международные дни ООН и ЮНЕСКО"

#: calendar/package/contents/ui/configHolidays.qml:141
#: win/host/settings/CalendarHolidays.qml:95
msgctxt "palette: colour of"
msgid "Other holidays:"
msgstr "Другие праздники:"

#: calendar/package/contents/ui/configHolidays.qml:148
#: win/host/settings/CalendarHolidays.qml:99
msgid ""
"A day off takes the weekends' colour; other holidays and world days this one."
msgstr ""
"Выходной берёт цвет выходных дней недели, другие праздники и мировые дни — "
"этот."

#: calendar/package/contents/ui/configHolidays.qml:153
#: win/host/settings/CalendarHolidays.qml:101
msgctxt "settings section"
msgid "Regions"
msgstr "Регионы"

#: calendar/package/contents/ui/configHolidays.qml:157
#: win/host/settings/CalendarHolidays.qml:105
