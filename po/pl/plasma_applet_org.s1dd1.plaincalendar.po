msgid ""
"Yandex: id.yandex.ru → Security → App passwords → Calendar.\n"
"iCloud: appleid.apple.com → Sign-in and security → App-specific passwords."
msgstr ""
"Yandex: id.yandex.ru → Bezpieczeństwo → Hasła aplikacji → Kalendarz.\n"
"iCloud: appleid.apple.com → Logowanie i zabezpieczenia → Hasła aplikacji."

