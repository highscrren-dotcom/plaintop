#: calendar/package/contents/ui/configAccounts.qml:316
msgid ""
"Yandex: id.yandex.ru → Security → App passwords → Calendar.\n"
"iCloud: appleid.apple.com → Sign-in and security → App-specific passwords."
msgstr ""
"Yandex：id.yandex.ru → 安全 → 应用专用密码 → 日历。\n"
"iCloud：appleid.apple.com → 登录与安全 → App 专用密码。"

