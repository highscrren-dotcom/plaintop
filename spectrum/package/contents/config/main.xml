<?xml version="1.0" encoding="UTF-8"?>
<kcfg xmlns="http://www.kde.org/standards/kcfg/1.0"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="http://www.kde.org/standards/kcfg/1.0
      http://www.kde.org/standards/kcfg/1.0/kcfg.xsd" >
  <kcfgfile name=""/>

  <group name="General">
    <!-- Shape. 0 = ring (a full circle at span 360, an arc below it), 1 = line.
         Both layouts feed the same element: only where the pivot sits and how far
         it is turned differs, so a new shape costs a formula, not a renderer. -->
    <!-- Click-through: the applet's wrapper in the shell is disabled, so both mouse
         buttons reach the desktop as if the widget were not there; only the shell's edit
         mode gives the widget the mouse back. Off by default: a first install that cannot
         be clicked would hide its own settings. XML comments forbid a double hyphen, so
         the installer's "clicks off" switch is spelled out rather than quoted. -->
    <entry name="clickThrough" type="Bool">
      <default>false</default>
    </entry>
    <entry name="layout" type="Int">
      <default>0</default>
    </entry>
    <entry name="bars" type="Int">
      <default>160</default>
    </entry>
    <entry name="radius" type="Int">
      <default>360</default>
    </entry>
    <entry name="span" type="Int">
      <default>360</default>
    </entry>
    <entry name="startAngle" type="Int">
      <default>0</default>
    </entry>
    <entry name="spacing" type="Int">
      <default>2</default>
    </entry>
    <entry name="thickness" type="Int">
      <default>5</default>
    </entry>
    <entry name="minLength" type="Int">
      <default>10</default>
    </entry>
    <entry name="maxLength" type="Int">
      <default>170</default>
    </entry>
    <!-- 0 outward (up on a line), 1 inward (down), 2 both ways from the baseline -->
    <entry name="growth" type="Int">
      <default>0</default>
    </entry>
    <entry name="mirror" type="Bool">
      <default>false</default>
    </entry>
    <entry name="reverse" type="Bool">
      <default>false</default>
    </entry>

    <!-- Element. 0 = solid bar, 1 = a stack of blocks.
         ⚠️ Blocks draw bars × blocks items, so the cost scales with both. -->
    <entry name="element" type="Int">
      <default>0</default>
    </entry>
    <entry name="blockSize" type="Int">
      <default>6</default>
    </entry>
    <entry name="blockGap" type="Int">
      <default>3</default>
    </entry>
    <entry name="rounded" type="Bool">
      <default>false</default>
    </entry>

    <!-- Appearance -->
    <entry name="color" type="String">
      <default>#C8CCD4</default>
    </entry>
    <entry name="colorHigh" type="String">
      <default></default>
    </entry>
    <entry name="opacityPercent" type="Int">
      <default>100</default>
    </entry>
    <entry name="guide" type="Bool">
      <default>false</default>
    </entry>

    <!-- Dynamics. dataRate drives the poll timer; smoothMs is the Qt animation that
         fills the gaps between data frames. Interpolating in JavaScript instead cost
         three times as much CPU — measured. -->
    <entry name="dataRate" type="Int">
      <default>30</default>
    </entry>
    <entry name="smoothMs" type="Int">
      <default>70</default>
    </entry>

    <!-- Silence. With nothing playing the ring fades out entirely and the widget drops
         to idleRate polls a second, so quiet costs almost nothing. When sound returns the
         ticks grow back out of the invisible ring. -->
    <entry name="hideWhenQuiet" type="Bool">
      <default>true</default>
    </entry>
    <entry name="quietThreshold" type="Int">
      <default>2</default>
    </entry>
    <entry name="quietDelayMs" type="Int">
      <default>900</default>
    </entry>
    <entry name="fadeMs" type="Int">
      <default>500</default>
    </entry>
    <entry name="idleRate" type="Int">
      <default>4</default>
    </entry>

    <!-- Source: the local relay that serves cava's bands over HTTP. -->
    <entry name="relayPort" type="Int">
      <default>8788</default>
    </entry>

    <!-- The player in the centre of the ring: the player widget's own view
         (player/shared/PlayerView.qml, copied in at install time) drawn over the free
         disc inside the bars, off by default. The keys mirror the player widget's, with
         the same defaults, prefixed so they sit next to the ring's in one group. -->
    <entry name="playerShow" type="Bool">
      <default>false</default>
    </entry>
    <!-- Which player to show: empty for whoever is playing, otherwise a part of the
         player's name or desktop entry, matched case-insensitively. -->
    <entry name="playerFilter" type="String">
      <default></default>
    </entry>
    <entry name="playerAlbum" type="Bool">
      <default>true</default>
    </entry>
    <entry name="playerControls" type="Bool">
      <default>true</default>
    </entry>
    <entry name="playerFontFamily" type="String">
      <default>JetBrainsMono Nerd Font Mono</default>
    </entry>
    <entry name="playerFontSize" type="Int">
      <default>10</default>
    </entry>
    <!-- Width of the player in characters: its board is this wide and five lines tall,
         and a longer title is cut with an ellipsis. It never changes the applet's size. -->
    <entry name="playerColumns" type="Int">
      <default>44</default>
    </entry>
    <entry name="playerColorFg" type="String">
      <default>#C8CCD4</default>
    </entry>
    <entry name="playerColorAccent" type="String">
      <default>#E05561</default>
    </entry>
    <entry name="playerColorDim" type="String">
      <default>#6B7280</default>
    </entry>
  </group>

</kcfg>
