<?xml version="1.0" encoding="UTF-8"?>
<kcfg xmlns="http://www.kde.org/standards/kcfg/1.0"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="http://www.kde.org/standards/kcfg/1.0
      http://www.kde.org/standards/kcfg/1.0/kcfg.xsd" >
  <kcfgfile name=""/>

  <group name="General">
    <!-- Click-through: the applet's wrapper in the shell is disabled, so both mouse
         buttons reach the desktop as if the widget were not there; only the shell's edit
         mode gives the widget the mouse back. Off by default, as in the weather. XML
         comments forbid a double hyphen, so the installer's "clicks off" switch is
         spelled out rather than quoted. -->
    <entry name="clickThrough" type="Bool">
      <default>false</default>
    </entry>
    <!-- Palette and font, the monitor's defaults: the widgets are meant to sit on one
         wallpaper as one text. Weekdays take the main colour, the weekends the accent
         (red on a wall calendar), the names, the week numbers and the neighbouring
         months' days the dim one; today's brackets take the monitor's value colour. -->
    <entry name="colorFg" type="String">
      <default>#C8CCD4</default>
    </entry>
    <entry name="colorAccent" type="String">
      <default>#E05561</default>
    </entry>
    <entry name="colorDim" type="String">
      <default>#6B7280</default>
    </entry>
    <entry name="colorToday" type="String">
      <default>#8FB6E0</default>
    </entry>
    <entry name="fontFamily" type="String">
      <default>JetBrainsMono Nerd Font Mono</default>
    </entry>
    <entry name="fontSize" type="Int">
      <default>10</default>
    </entry>
    <!-- How many months: 1, the current one, or 3, the previous, the current and the
         next, one under another as on a quarterly wall calendar. -->
    <entry name="months" type="Int">
      <default>3</default>
    </entry>
    <!-- A day's column in characters: the number sits in the middle, today's brackets
         take the outer two, so four is the least that holds "[31]". The applet's width
         is seven cells plus the week-number column, and its height eight lines per
         month plus a blank line between months, so the size hint stays constant for
         the given settings whatever month is shown (see docs/GOTCHAS.md on Layout.*). -->
    <entry name="cellWidth" type="Int">
      <default>4</default>
    </entry>
    <!-- ISO 8601 week numbers in front of the rows, as on the wall. -->
    <entry name="weekNumbers" type="Bool">
      <default>true</default>
    </entry>
    <!-- The first column of the grid: 0 follows the locale's first day of the week,
         otherwise a Qt day, 1 Monday or 7 Sunday. -->
    <entry name="firstDay" type="Int">
      <default>0</default>
    </entry>
    <!-- The neighbouring months' days in the cells before the 1st and after the last,
         in the dim colour; off, those cells stay empty, as on the wall. -->
    <entry name="fillDays" type="Bool">
      <default>false</default>
    </entry>
    <!-- The weekend, as the locale defines it, in the accent colour. -->
    <entry name="weekendAccent" type="Bool">
      <default>true</default>
    </entry>

    <!-- Notes and calendars: a day with an entry — a note of yours, an event or a task
         from an account — takes the note colour, a click on it opens the sticker, and
         the next few entries are printed under the months. Off, the calendar is the
         plain grid and takes no clicks. The data comes from contents/code/notes.py,
         run through the executable engine; the accounts live in its own file. -->
    <entry name="notes" type="Bool">
      <default>true</default>
    </entry>
    <entry name="colorNote" type="String">
      <default>#8FB6E0</default>
    </entry>
    <!-- Lines of upcoming entries under the months, 0 for none; the board reserves
         them, so the size hint stays constant. -->
    <entry name="upcoming" type="Int">
      <default>3</default>
    </entry>
    <!-- The account the widget's own notes are written to: "local" is the folder of
         .ics files, otherwise an account id from the Accounts page. -->
    <entry name="noteAccount" type="String">
      <default>local</default>
    </entry>
    <!-- Minutes between fetches of the accounts. -->
    <entry name="syncMinutes" type="Int">
      <default>15</default>
    </entry>
    <!-- The sticker: a flat sheet of the paper colour at this opacity, framed with
         characters — eight of them: top-left, horizontal, top-right, vertical,
         bottom-left, bottom-right, and the two junctions of a separator row; "+-+|+++"
         in ASCII — this many characters wide inside the frame, and opened with no
         animation (0), a fade (1) or unfolding line by line (2). -->
    <entry name="colorPaper" type="String">
      <default>#141820</default>
    </entry>
    <entry name="paperOpacity" type="Int">
      <default>94</default>
    </entry>
    <entry name="frame" type="String">
      <default>┌─┐│└┘├┤</default>
    </entry>
    <entry name="stickerColumns" type="Int">
      <default>40</default>
    </entry>
    <entry name="stickerAnimation" type="Int">
      <default>2</default>
    </entry>
    <!-- Reminders. A note whose first line starts with a time ("14:30 Dentist") rings
         remindLead minutes before it; one starting with "!" rings at remindHour of its day;
         the accounts' events ring by their own VALARMs, and timed ones without any
         remindLead minutes before when remindEvents is on. A reminder is a sheet by the
         day's cell with snooze and done; an alarm older than remindMissed hours is dropped.
         Optionally a system notification (notify-send) and a sound file too. -->
    <entry name="reminders" type="Bool">
      <default>true</default>
    </entry>
    <entry name="remindLead" type="Int">
      <default>10</default>
    </entry>
    <entry name="remindHour" type="String">
      <default>09:00</default>
    </entry>
    <entry name="remindEvents" type="Bool">
      <default>true</default>
    </entry>
    <entry name="remindMissed" type="Int">
      <default>12</default>
    </entry>
    <entry name="snoozeMinutes" type="Int">
      <default>10</default>
    </entry>
    <entry name="remindSystem" type="Bool">
      <default>false</default>
    </entry>
    <entry name="remindSound" type="String">
      <default></default>
    </entry>
  </group>

</kcfg>
